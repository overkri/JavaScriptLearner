{
  "name": "taskflow-js-course",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TaskFlow — курс JavaScript для Java-разработчика с проверяемыми упражнениями",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:m": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npx -y -p typescript tsc -p jsconfig.json --noEmit",
    "verify": "node scripts/verify-solutions.js",
    "verify:m": "node scripts/verify-module.js",
    "progress": "node scripts/progress.js"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
